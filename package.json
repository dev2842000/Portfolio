  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "colorthief": "^2.3.0",
    "gh-pages": "^2.1.1",
    "jest-canvas-mock": "^2.3.1",
    "lottie-react": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-emoji": "^1.8.1",
