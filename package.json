    "react-reveal": "^1.2.2",
    "react-twitter-embed": "3.0.3",
    "sass": "^1.32.8",
    "three": "^0.185.1"
  },
  "scripts": {
    "dev": "vite",
    "predeploy": "npm run build",
    "start": "node fetch.js && vite",
    "build": "node fetch.js && vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.js",
    "preview": "vite preview",
    "deploy": "gh-pages -b master -d dist/client",
    "format": "prettier --write \"./**/*.{js,jsx,css,json,scss}\"",
    "check-format": "prettier -c \"./**/*.{js,jsx,css,json,scss}\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "dotenv": "^8.2.0",
    "prettier": "^2.3.1",
    "vite": "^5.0.0"
  }
